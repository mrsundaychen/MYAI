DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# agent 操作的根目录，留空则使用当前工作目录
PROJECT_ROOT=

# 默认用户标识（用于 token 配额统计）
AGENT_USER=default
# mock token 配额，可按用户通过 --user / --quota 覆盖
TOKEN_QUOTA=100000
# 用量文件路径，留空则使用项目目录下的 .usage.json
AGENT_USAGE_FILE=
